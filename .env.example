# ==============================================================================
# Telegram to Dropbox Serverless Sync & Webhook Configuration
# Copy this file to '.env' and populate your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram API & Bot Credentials
# ------------------------------------------------------------------------------
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Obtain from https://my.telegram.org (Under 'API development tools')
# Required for Telethon high-speed MTProto engine (supporting up to 2 GB files)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# Optional: Random alphanumeric string (1-256 chars) to authenticate Telegram Webhook requests
# Header: X-Telegram-Bot-Api-Secret-Token
TELEGRAM_SECRET_TOKEN=my_secure_random_token_12345

# ------------------------------------------------------------------------------
# 2. GitHub Actions Serverless Dispatcher
# ------------------------------------------------------------------------------
# Your GitHub repository (format: owner/repository_name)
GH_REPO=DexterDevKH/TelegramDropboxBot

# GitHub Personal Access Token (PAT)
# Needs permissions: 'repo' (Classic) or 'Actions: Read & write' + 'Metadata: Read' (Fine-grained)
# Generate at: https://github.com/settings/tokens
GH_PAT=ghp_yourPersonalAccessTokenHere

# ------------------------------------------------------------------------------
# 3. Dropbox Cloud Storage Credentials
# ------------------------------------------------------------------------------
# Obtain from https://www.dropbox.com/developers/apps
DROPBOX_APP_KEY=your_app_key
DROPBOX_APP_SECRET=your_app_secret
DROPBOX_REFRESH_TOKEN=your_refresh_token

# Optional: Legacy short-lived token (Refresh token is strongly recommended instead)
DROPBOX_ACCESS_TOKEN=

# Remote destination folder inside Dropbox (must start with /)
DROPBOX_TARGET_FOLDER=/Telegram Uploads

# ------------------------------------------------------------------------------
# 4. Security, Access & Storage Rules
# ------------------------------------------------------------------------------
# Comma-separated list of Telegram user IDs permitted to use the bot
# Obtain your ID by sending a message to @userinfobot on Telegram
# Leave empty to allow public access (not recommended)
AUTHORIZED_USER_IDS=123456789,987654321

# FIFO Retention Policy: Max number of files kept in Dropbox target folder
MAX_FILES_IN_FOLDER=2

# Mask filenames, usernames, and cloud paths in workflow and terminal logs
PRIVACY_MODE=true

# Chunk size for streaming uploads to Dropbox (in Megabytes)
CHUNK_SIZE_MB=8

# Keep-alive window (0 = exit immediately upon completing transfer)
IDLE_KEEP_ALIVE_SECONDS=0

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

