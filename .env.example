# ==============================================================================
# Telegram to Dropbox Cloud Sync & iOS IPA Workflow Builder
# Configuration Template - Copy this file to '.env' and populate your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram API & Bot Credentials
# ------------------------------------------------------------------------------
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram API ID and Hash from https://my.telegram.org (Under 'API development tools')
# Required for high-speed MTProto binary transfer (supporting files up to 2.0 GB)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# Optional: Secret token to verify Telegram Webhook requests to Cloudflare Worker
# Matches header: X-Telegram-Bot-Api-Secret-Token
TELEGRAM_SECRET_TOKEN=my_secure_random_token_12345

# ------------------------------------------------------------------------------
# 2. GitHub Actions Serverless Dispatcher
# ------------------------------------------------------------------------------
# Target GitHub repository (format: owner/repository_name)
GH_REPO=DexterDevKH/TelegramDropboxBot

# GitHub Personal Access Token (PAT)
# Required permissions:
# - Classic PAT: 'repo' or 'actions:write'
# - Fine-grained PAT: 'Actions: Read and write' + 'Metadata: Read'
# Generate at: https://github.com/settings/tokens
GH_PAT=ghp_yourPersonalAccessTokenHere

# ------------------------------------------------------------------------------
# 3. Dropbox Cloud Storage Credentials
# ------------------------------------------------------------------------------
# Obtain from https://www.dropbox.com/developers/apps
DROPBOX_APP_KEY=your_app_key
DROPBOX_APP_SECRET=your_app_secret

# Permanent OAuth 2.0 offline refresh token (Generate via: python get_refresh_token.py)
DROPBOX_REFRESH_TOKEN=your_refresh_token

# Optional: Short-lived access token (Refresh token recommended instead)
DROPBOX_ACCESS_TOKEN=

# Remote destination folder in Dropbox (must begin with /)
DROPBOX_TARGET_FOLDER=/IPA

# ------------------------------------------------------------------------------
# 4. Security, Access & Storage Rules
# ------------------------------------------------------------------------------
# Comma-separated list of authorized Telegram user IDs (leave empty to allow all users)
# Obtain your user ID from @userinfobot
AUTHORIZED_USER_IDS=123456789,987654321

# FIFO Folder Retention Cap: Maximum number of files to retain before auto-pruning oldest
MAX_FILES_IN_FOLDER=2

# Privacy Mode: Mask filenames, user IDs, and cloud paths in workflow console logs (true/false)
PRIVACY_MODE=true

# Chunk size for streaming uploads to Dropbox in Megabytes (recommended: 8 or 16)
CHUNK_SIZE_MB=8

# Keep-alive window for multi-file batches in seconds (0 = terminate immediately after transfer)
IDLE_KEEP_ALIVE_SECONDS=0

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
